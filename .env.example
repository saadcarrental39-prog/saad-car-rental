# Public values only. Never put private keys in VITE_ variables.
VITE_WHATSAPP_NUMBER=        # digits only with country code, e.g. 923XXXXXXXXX
VITE_PHONE_NUMBER=           # e.g. +923XXXXXXXXX
VITE_SITE_URL=https://www.saadcarremtal.com
VITE_GA4_ID=                 # optional Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (conversion events are sent automatically)
VITE_CF_BEACON=              # optional Cloudflare Web Analytics token

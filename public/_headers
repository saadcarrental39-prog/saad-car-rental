# Hashed JS/CSS never change -> cache forever.
/bundle/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
# Every page (HTML) must be re-checked on each visit. Otherwise a browser can keep an OLD page that points to deleted
# JS files after a new deploy -> white screen until refresh (and again on Back).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/cars
  Cache-Control: no-cache
/cars/*
  Cache-Control: no-cache
/services
  Cache-Control: no-cache
/about
  Cache-Control: no-cache
/contact
  Cache-Control: no-cache
/book
  Cache-Control: no-cache
/admin-sw.js
  Cache-Control: no-cache
/admin.webmanifest
  Cache-Control: no-cache
/saad-owner-7k3x9
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
/saad-owner-7k3x9/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow

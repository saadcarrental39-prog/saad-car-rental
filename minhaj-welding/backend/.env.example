# MINHAJ WELDING - Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=3001
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,https://minhajwelding.com

# JWT secret - CHANGE THIS to a long random string before going live
JWT_SECRET=change-this-to-a-long-random-secret-string

# SQLite database file path (default: backend/database/minhaj_welding.db)
# DB_PATH=./database/minhaj_welding.db

# Puppeteer (PDF generation) - only needed if Chromium download fails
# during npm install (e.g. no internet). Point to an existing Chrome:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

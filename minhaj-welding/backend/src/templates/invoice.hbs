<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<style>
  * { box-sizing: border-box; }
  body { font-family: 'Helvetica', Arial, sans-serif; color: #000000; background: #FFFFFF; padding: 32px; }
  .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #2563EB; padding-bottom: 16px; margin-bottom: 24px; }
  .business-name { font-size: 24px; font-weight: bold; }
  .doc-title { font-size: 20px; font-weight: bold; color: #2563EB; text-align: right; }
  .meta { font-size: 12px; color: #1A1A1A; text-align: right; margin-top: 4px; }
  .status { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 12px; color: #FFFFFF; margin-top: 8px; }
  .status.paid { background: #16A34A; }
  .status.partial { background: #F59E0B; }
  .status.unpaid { background: #DC2626; }
  .totals { margin-top: 24px; width: 300px; margin-left: auto; }
  .totals-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
  .totals-row.grand { font-weight: bold; font-size: 18px; border-top: 2px solid #000000; padding-top: 8px; }
  table { width: 100%; border-collapse: collapse; margin-top: 24px; }
  th { background: #2563EB; color: #FFFFFF; text-align: left; padding: 8px; font-size: 12px; }
  td { padding: 8px; border-bottom: 1px solid #E5E7EB; font-size: 12px; }
</style>
</head>
<body>
  <div class="header">
    <div>
      <div class="business-name">{{business_name}}</div>
      <div>{{owner_1_name}}: {{owner_1_phone}}</div>
    </div>
    <div>
      <div class="doc-title">INVOICE</div>
      <div class="meta">#{{invoice_no}}</div>
      <div class="meta">Date: {{date}}</div>
      <div class="status {{status}}">{{status}}</div>
    </div>
  </div>

  <div>
    <strong>Bill To:</strong> {{customer_name}} — {{customer_phone}}
  </div>

  <div class="totals">
    <div class="totals-row"><span>Total Amount</span><span>Rs. {{total_amount}}</span></div>
    <div class="totals-row"><span>Paid Amount</span><span>Rs. {{paid_amount}}</span></div>
    <div class="totals-row grand"><span>Balance</span><span>Rs. {{balance_amount}}</span></div>
  </div>

  {{#if payments.length}}
  <table>
    <thead><tr><th>Date</th><th>Amount</th><th>Mode</th><th>Note</th></tr></thead>
    <tbody>
      {{#each payments}}
      <tr><td>{{this.paid_at}}</td><td>Rs. {{this.amount}}</td><td>{{this.mode}}</td><td>{{this.note}}</td></tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}
</body>
</html>
